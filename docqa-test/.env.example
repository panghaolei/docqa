# ================= DocQA 测试工程环境变量模板 =================
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# 被测服务地址（后端 context-path 为 /api）
DOCQA_TEST_BASE_URL=http://localhost:8080/api

# 前端地址（仅 e2e UI 自动化需要）
DOCQA_TEST_FRONT_URL=http://localhost:5173

# 硅基流动 API Key：用于 LLM-as-a-Judge 回答质量判分
# 不配置时，AI 判分相关断言会自动跳过（用例不会失败）
SILICONFLOW_API_KEY=

# AI 判分使用的对话模型
DOCQA_TEST_JUDGE_MODEL=deepseek-ai/DeepSeek-V3
